<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="aubo_iS10">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />
    <xacro:arg name="use_real_hardware" default="false" />
    <xacro:arg name="robot_ip" default="192.168.10.2" />

    <!-- Import aubo_iS10 urdf file -->
    <xacro:include filename="$(find aubo_moveit_config)/config/aubo_iS10.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="aubo_iS10.ros2_control.xacro" />

    <xacro:aubo_iS10_ros2_control
        name="Aubo_iS10System"
        initial_positions_file="$(arg initial_positions_file)"
        use_real_hardware="$(arg use_real_hardware)"
        robot_ip="$(arg robot_ip)"/>

</robot>